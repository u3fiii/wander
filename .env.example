# Shared leaderboard (Supabase). Copy this file to .env.local and fill in both values from your Supabase project:
# Project Settings → API → Project URL, and the "anon" / "publishable" public key.
# Without them the game keeps a leaderboard in each browser only.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
